# copy to .env and fill in, compose auto-loads web/.env when run from web/.
# .env is gitignored, this template isn't. every var has a default in compose,
# so only CHESS_DOMAIN actually needs setting (and only for prod).

# prod ingress (required for docker-compose.prod.yml)
# the public host traefik routes to. frontend served here, /api/* goes to gateway.
CHESS_DOMAIN=chess.example.com

# gateway tuning (optional)
# prod sets CORS to https://$CHESS_DOMAIN itself, so this is dev-only
# CORS_ORIGINS=http://localhost:3000
UNLIMITED_THINK_MS=5000
HINT_THINK_MS=1500
TIMEOUT_SLACK_MS=5000

# echo (optional)
MAIA_ELO=1700
ECHO_USE_BOOK=true
ECHO_BOOK_ONLY=false
# where the dropped-in assets live inside the container, match the image layout
LC0_PATH=/app/echo/bin/lc0
WEIGHTS_DIR=/app/echo/artifacts/weights

# cloudflare tunnel (optional, only if you add a cloudflared service)
# real token goes in .env, never here
# CLOUDFLARE_TUNNEL_TOKEN=replace-with-your-tunnel-token
