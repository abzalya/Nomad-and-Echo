FROM python:3.11-slim

WORKDIR /app

COPY web/gateway/requirements.txt /app/web/gateway/requirements.txt
RUN pip install --no-cache-dir -r /app/web/gateway/requirements.txt

COPY web/gateway/ /app/web/gateway/

WORKDIR /app/web/gateway
EXPOSE 8000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
